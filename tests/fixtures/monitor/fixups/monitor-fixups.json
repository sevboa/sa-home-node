      "check_before": false,
      "check_after": true,
      "calls": [
        [
          "/usr/bin/visudo",
          "-cf",
          "<tmp>"
        ],
        [
          "sudo",
          "install",
          "-m",
          "0440",
          "-o",
          "root",
          "-g",
          "root",
          "<tmp>",
          "/etc/sudoers.d/50-sa-home-node-smartctl"
        ]
      ],
      "installed": {
        "/etc/sudoers.d/50-sa-home-node-smartctl": "user-a ALL=(root) NOPASSWD: /usr/bin/smartctl *\n"
      },
      "files": {
        "wrapper": {
          "content": "#!/bin/sh\nexec sudo -n /usr/bin/smartctl \"$@\"\n",
          "mode": "0o755"
        }
