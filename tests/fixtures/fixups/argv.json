    "installed": {
      "/etc/polkit-1/rules.d/50-sa-home-node-power.rules": "// Сгенерировано sa-home-bot (nodectl fix) — нода-супервизор выключает/перезагружает/усыпляет свою workstation без sudo.\npolkit.addRule(function(action, subject) {\n    if ([\n        \"org.freedesktop.login1.power-off\",\n        \"org.freedesktop.login1.power-off-multiple-sessions\",\n        \"org.freedesktop.login1.reboot\",\n        \"org.freedesktop.login1.reboot-multiple-sessions\",\n        \"org.freedesktop.login1.suspend\",\n        \"org.freedesktop.login1.suspend-multiple-sessions\"\n    ].indexOf(action.id) !== -1 && subject.user == \"user-a\") {\n        return polkit.Result.YES;\n    }\n});\n"
    }
  },
